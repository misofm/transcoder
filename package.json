{
  "name": "@misofm/transcoder",
  "version": "0.2.0",
  "description": "Effect-based deterministic plaintext AAC fMP4 HLS transcoder.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/misofm/transcoder.git"
  },
  "homepage": "https://github.com/misofm/transcoder#readme",
  "bugs": {
    "url": "https://github.com/misofm/transcoder/issues"
  },
  "type": "module",
  "license": "Apache-2.0",
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22 <25",
    "bun": ">=1.4.0"
  },
  "packageManager": "bun@1.4.0",
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "default": "./dist/node.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "test:unit": "bun test test/artifact-contract.test.ts test/dependency-contract.test.ts test/fault-injection.test.ts test/ffmpeg.test.ts test/hls-player.test.ts test/hls.test.ts test/native-process.test.ts test/profile.test.ts test/workspace.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pack:check": "npm pack --dry-run --json",
    "player": "bun examples/hls-player/server.js"
  },
  "dependencies": {
    "m3u8-parser": "7.2.0"
  },
  "peerDependencies": {
    "@effect/platform-node": "4.0.0-rc.112",
    "effect": "4.0.0-rc.112"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.0-rc.112",
    "@types/bun": "1.2.22",
    "@types/node": "24.10.1",
    "effect": "4.0.0-rc.112",
    "hls.js": "1.6.13",
    "playwright": "1.55.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  }
}
